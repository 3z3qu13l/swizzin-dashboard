#!/bin/bash
# swizdash root helper. The dashboard runs unprivileged and may only run this script
# through sudo (see /etc/sudoers.d/swizdash). Every argument is checked here: the
# caller is treated as untrusted.
set -uo pipefail
export LC_ALL=C PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

catalog=/opt/swizdash/catalog/apps.json
# root-owned: the dashboard user must not be able to plant links where root writes
jobs_dir=/var/log/swizdash/jobs

die() {
    echo "swizdash-helper: $*" >&2
    exit 2
}

master() { cut -d: -f1 < /root/.master.info; }

# swizzin users, one per line
users() {
    # shellcheck source=/dev/null
    . /etc/swizzin/sources/functions/users
    _get_user_list
}

is_user() {
    local u
    while read -r u; do [[ $u == "$1" ]] && return 0; done < <(users)
    return 1
}

valid_app() {
    [[ $1 =~ ^[a-z0-9_-]{1,32}$ ]] || die "invalid app"
    jq -e --arg a "$1" '.apps[] | select(.id == $a)' "$catalog" > /dev/null || die "unknown app"
}

app_field() { jq -r --arg a "$1" ".apps[] | select(.id == \$a) | $2 // empty" "$catalog"; }

# start, stop or restart a unit listed in the catalog. Templates only for a swizzin user.
cmd_service() {
    local action=${1:-} unit=${2:-} base instance=""
    [[ $action =~ ^(start|stop|restart)$ ]] || die "invalid action"
    [[ $unit =~ ^([a-z0-9-]{1,40})(@([a-z][a-z0-9_.-]{0,31}))?$ ]] || die "invalid unit"
    base=${BASH_REMATCH[1]}
    instance=${BASH_REMATCH[3]}
    if [[ -n $instance ]]; then
        jq -e --arg u "${base}@" '[.apps[].units[]] | index($u)' "$catalog" > /dev/null || die "unit not in catalog"
        is_user "$instance" || die "unknown user"
    else
        jq -e --arg u "$base" '[.apps[].units[]] | index($u)' "$catalog" > /dev/null || die "unit not in catalog"
    fi
    # the dashboard cannot stop itself or the web server it is reached through
    if [[ $action == stop && $base =~ ^(swizdash|nginx)$ ]]; then
        die "refusing to stop $base"
    fi
    # restarting the dashboard or nginx would cut this very request: let it answer first
    if [[ $base =~ ^(swizdash|nginx)$ ]]; then
        systemd-run --quiet --collect --on-active=2 /bin/systemctl "$action" "${unit}.service"
        return
    fi
    systemctl "$action" "${unit}.service"
}

# Runs a command as a swizzin user. setpriv opens no PAM session, so the polling
# leaves no line in auth.log, unlike runuser or su.
as_user() {
    local u=$1
    shift
    setpriv --reuid="$u" --regid="$u" --init-groups --reset-env -- "$@"
}

# Reads a file, as its owner when it sits in a home: root following a link planted
# there could read anything. A FIFO or a slow disk cannot hold the helper.
read_file() {
    local u=$1 file=$2
    if [[ $file == /home/* ]]; then
        timeout 3 setpriv --reuid="$u" --regid="$u" --init-groups --reset-env -- head -c 262144 "$file" 2> /dev/null
    else
        timeout 3 head -c 262144 "$file" 2> /dev/null
    fi
}

# a value from a config file on stdin
read_key() {
    local type=$1 key=$2
    case $type in
        xml) grep -m1 -oP "<${key}>\K[^<]+" ;;
        json) jq -r --arg k "$key" '.[$k] // empty' 2> /dev/null ;;
        ini) grep -m1 -oP "^\s*${key}\s*=\s*\K\S+" ;;
        yaml) grep -m1 -oP "^\s*${key}:\s*['\"]?\K[^'\"\s]+" ;;
    esac
}

# paths that exist, the API key and, for the *arr apps, the version from their API
cmd_appinfo() {
    local app=${1:-} user paths key file type kname arrconf api port base version="" conf
    valid_app "$app"
    user=$(master)
    paths=$(jq -c --arg a "$app" '.apps[] | select(.id == $a) | .paths // {}' "$catalog")
    paths=$(jq -c --arg u "$user" 'with_entries(.value |= gsub("\\{user\\}"; $u))' <<< "$paths")
    paths=$(jq -c 'to_entries' <<< "$paths" | jq -c '.[]' | while read -r entry; do
        p=$(jq -r .value <<< "$entry")
        if [[ $p == /home/* ]]; then
            as_user "$user" test -e "$p" && e=true || e=false
        elif [[ -e $p ]]; then e=true; else e=false; fi
        jq -c --argjson e "$e" '{(.key): {path: .value, exists: $e}}' <<< "$entry"
    done | jq -sc 'add // {}')

    file=$(app_field "$app" '.apikey.file')
    key=""
    if [[ -n $file ]]; then
        file=${file//\{user\}/$user}
        type=$(app_field "$app" '.apikey.type')
        kname=$(app_field "$app" '.apikey.key')
        key=$(read_file "$user" "$file" | read_key "$type" "$kname")
    fi

    arrconf=$(app_field "$app" '.version.arr')
    if [[ -n $arrconf ]]; then
        conf=$(read_file "$user" "${arrconf//\{user\}/$user}")
        api=$(app_field "$app" '.version.api')
        port=$(read_key xml Port <<< "$conf")
        base=$(read_key xml UrlBase <<< "$conf")
        # the config belongs to the user: only a port and a plain path may reach the URL
        if [[ $port =~ ^[0-9]{1,5}$ && $base =~ ^(/[A-Za-z0-9._-]+)*$ && -n $key ]]; then
            # secrets never go in arguments: any local user can read them in ps
            version=$(printf 'X-Api-Key: %s\n' "$key" | curl -fsS -m 5 -H @- "http://127.0.0.1:${port}${base}/api/${api}/system/status" 2> /dev/null | jq -r '.version // empty' 2> /dev/null)
        fi
    fi
    # probes of programs in the master's home run as the master, not as root
    local probe output=""
    probe=$(app_field "$app" '.version.cmd')
    if [[ $probe == *'{user}'* ]]; then
        output=$(timeout 10 setpriv --reuid="$user" --regid="$user" --init-groups --reset-env -- /bin/sh -c "${probe//\{user\}/$user}" 2>&1 | head -c 2000)
    fi
    # the key goes through the environment, readable by root only, not the arguments
    KEY=$key jq -nc --argjson paths "$paths" --arg version "$version" --arg output "$output" \
        '{paths: $paths, apikey: (if env.KEY == "" then null else env.KEY end), version: (if $version == "" then null else $version end), versionOutput: (if $output == "" then null else $output end)}'
}

# Installs or removes an app in the background with box, one job at a time.
cmd_job() {
    local kind=${1:-} app=${2:-} id
    [[ $kind =~ ^(install|remove)$ ]] || die "invalid job"
    valid_app "$app"
    [[ -f /usr/local/bin/swizzin/${kind}/${app}.sh ]] || die "no ${kind} script for ${app}"
    if [[ $(app_field "$app" '.core') == true ]]; then die "${app} is managed with box only"; fi
    if [[ $kind == install ]]; then
        [[ $(app_field "$app" '.interactive') == true ]] && die "${app} asks questions while installing, use box install ${app} over SSH"
        [[ -f /install/.${app}.lock ]] && die "${app} is already installed"
    else
        [[ $(app_field "$app" '.removeInteractive') == true ]] && die "${app} asks questions while removing, use box remove ${app} over SSH"
        [[ -f /install/.${app}.lock ]] || die "${app} is not installed"
    fi
    # two requests at the same moment must not both pass the checks below
    exec 9> /run/swizdash-helper.lock
    flock -n 9 || die "another install or removal is starting"
    if systemctl list-units --plain --no-legend --state=activating,active 'swizdash-job-*' | grep -q .; then
        die "another install or removal is running"
    fi
    if pgrep -f '/usr/local/bin/swizzin/(install|remove|upgrade)/' > /dev/null; then
        die "box is already running on the server"
    fi
    mkdir -p "$jobs_dir"
    id="$(date +%s)-${kind}-${app}"
    printf '%s %s\n' "$kind" "$app" > "${jobs_dir}/${id}.job"
    # no terminal: an unexpected question gets its default answer instead of hanging.
    # The single quotes are on purpose: the job's own bash expands $0, $1 and $?.
    # The lock file at the end says whether the app is there, box often exits 0 on errors.
    # shellcheck disable=SC2016
    systemd-run --quiet --collect --unit="swizdash-job-${id}" \
        --property=StandardInput=null \
        --property="StandardOutput=file:${jobs_dir}/${id}.log" \
        --property=StandardError=inherit \
        --setenv=TERM=dumb --setenv=HOME=/root \
        --setenv=PATH=/usr/local/sbin:/usr/local/bin:/usr/local/bin/swizzin:/usr/sbin:/usr/bin:/sbin:/bin \
        /bin/bash -c '/usr/local/bin/swizzin/box "$0" "$1"; rc=$?; [[ -f /install/.$1.lock ]] && l=1 || l=0; echo "[swizdash] exit $rc lock $l"' "$kind" "$app" || die "could not start the job"
    # leaves the 20 newest jobs
    find "$jobs_dir" -maxdepth 1 -name '*.job' -printf '%T@ %p\n' | sort -rn | tail -n +21 | cut -d' ' -f2 |
        while read -r f; do rm -f "$f" "${f%.job}.log"; done
    echo "$id"
}

# the install and remove scripts box has, /etc/swizzin is readable by root only
cmd_scripts() {
    local kind
    for kind in install remove; do
        find "/usr/local/bin/swizzin/${kind}/" -maxdepth 1 -name '*.sh' -printf '%f\n' 2> /dev/null | sed 's/\.sh$//' |
            jq -Rsc --arg k "$kind" '{($k): (split("\n") | map(select(. != "")))}'
    done | jq -sc 'add'
}

cmd_smart() {
    command -v smartctl > /dev/null || {
        echo '{"available": false, "disks": []}'
        return 0
    }
    local d out
    {
        for d in $(lsblk -dnpo NAME,TYPE | awk '$2 == "disk" {print $1}'); do
            out=$(smartctl -j -H -A -i "$d" 2> /dev/null) || true
            [[ -n $out ]] && jq -c --arg d "$d" '{device: $d, model: (.model_name // .model_family // null), passed: (.smart_status.passed // null), temperature: (.temperature.current // null), power_on_hours: (.power_on_time.hours // null), reallocated: ([.ata_smart_attributes.table[]? | select(.id == 5) | .raw.value][0] // null), type: (.device.type // null)}' <<< "$out" 2> /dev/null
        done
    } | jq -sc '{available: true, disks: .}'
}

cmd_fail2ban() {
    if ! command -v fail2ban-client > /dev/null || ! systemctl is-active -q fail2ban; then
        echo '{"available": false}'
        return 0
    fi
    local jails j f tmp
    tmp=$(mktemp -d)
    jails=$(fail2ban-client status 2> /dev/null | grep -oP 'Jail list:\s*\K.*' | tr -d ' ' | tr ',' ' ')
    {
        for j in $jails; do
            [[ $j =~ ^[A-Za-z0-9_.-]+$ ]] || continue
            fail2ban-client status "$j" 2> /dev/null | jq -Rsc --arg j "$j" '{jail: $j, banned: ((capture("Banned IP list:\\s*(?<l>[^\\n]*)").l // "") | split(" ") | map(select(. != ""))), total: ((capture("Total banned:\\s*(?<n>[0-9]+)").n // "0") | tonumber), failed: ((capture("Currently failed:\\s*(?<n>[0-9]+)").n // "0") | tonumber)}'
        done
    } | jq -sc '.' > "${tmp}/jails"
    # ban events of the last 30 days from the logs, newest log first, at most 5000
    {
        for f in /var/log/fail2ban.log /var/log/fail2ban.log.1; do [[ -f $f ]] && cat "$f"; done
        for f in /var/log/fail2ban.log.*.gz; do [[ -f $f ]] && zcat "$f"; done
    } 2> /dev/null | grep -P '\] Ban [0-9a-fA-F.:]+$' | head -n 5000 |
        awk -v since="$(date -d '30 days ago' '+%Y-%m-%d')" '$1 >= since {jail=$0; sub(/.*\[/, "", jail); sub(/\].*/, "", jail); print $1 "T" substr($2, 1, 8), jail, $NF}' |
        jq -Rsc 'split("\n") | map(select(. != "") | split(" ") | {at: .[0], jail: .[1], ip: .[2]})' > "${tmp}/events"
    jq -nc --slurpfile j "${tmp}/jails" --slurpfile e "${tmp}/events" '{available: true, jails: $j[0], events: $e[0]}'
    rm -rf "$tmp"
}

cmd_quota() {
    local user
    user=$(master)
    if ! command -v quota > /dev/null || [[ ! -f /install/.quota.lock ]]; then
        echo '{"available": false}'
        return 0
    fi
    # blocks are 1 KiB
    local usage
    usage=$(quota -wu "$user" 2> /dev/null | awk 'NR > 2 && NF >= 4 {gsub(/\*/, "", $2); print $2, $3; exit}')
    # no quota set for the master
    if [[ ! $usage =~ ^[0-9]+\ [0-9]+$ ]]; then
        echo '{"available": false}'
        return 0
    fi
    jq -Rc 'split(" ") | {available: true, used: ((.[0] | tonumber) * 1024), limit: ((.[1] | tonumber) * 1024)}' <<< "$usage"
}

# curl config on stdin: the password stays out of the arguments
curl_auth() {
    local v="$1:$2"
    v=${v//\\/\\\\}
    v=${v//\"/\\\"}
    printf 'user = "%s"\n' "$v"
}

# Every client's torrents become {name, status, progress (0 to 1), size, ratio, down, up},
# summed up here into one object per client and user. At most 1000 torrents are listed.
summarize() {
    cat << 'JQ'
def summarize($client; $user; $folder):
  map(.name //= "")
  | {
    client: $client,
    user: $user,
    folder: (if $folder == "" then null else $folder end),
    down: (map(.down) | add // 0),
    up: (map(.up) | add // 0),
    total: length,
    active: (map(select(.status == "downloading")) | length),
    counts: (reduce .[] as $t ({downloading: 0, seeding: 0, queued: 0, checking: 0, stopped: 0, error: 0}; .[$t.status] += 1)),
    size: (map(.size) | add // 0),
    done: (map(.size * .progress) | add // 0),
    truncated: (length > 1000),
    items: (sort_by(.status != "downloading", .status, .name) | .[:1000] | map({name, status, progress, size, ratio}))
  };
JQ
}

# qBittorrent bans 127.0.0.1 after 5 failed logins, which would also lock nginx out:
# after a failed login (password changed in qBittorrent), wait an hour before trying again
qbt_mark=/run/swizdash-qbt-failed

# torrents of one user, client by client
user_downloads() {
    local u=$1 pass port sid folder jar reply
    pass=$(_get_user_password "$u")
    if [[ -S /var/run/${u}/.rtorrent.sock ]]; then
        timeout 6 setpriv --reuid="$u" --regid="$u" --init-groups --reset-env -- python3 - "/var/run/${u}/.rtorrent.sock" 2> /dev/null << 'PY' |
import json, socket, sys, xmlrpc.client

def call(method, *params):
    body = xmlrpc.client.dumps(params, method).encode()
    head = b"CONTENT_LENGTH\x00%d\x00SCGI\x001\x00" % len(body)
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(4)
    s.connect(sys.argv[1])
    s.sendall(b"%d:%s,%s" % (len(head), head, body))
    data = b""
    while chunk := s.recv(65536):
        data += chunk
        if len(data) > 32 << 20:
            sys.exit(1)
    s.close()
    return xmlrpc.client.loads(data.split(b"\r\n\r\n", 1)[1])[0][0]

fields = ["d.name=", "d.state=", "d.complete=", "d.is_active=", "d.hashing=", "d.message=", "d.size_bytes=", "d.completed_bytes=", "d.ratio=", "d.down.rate=", "d.up.rate="]
items = []
for name, state, complete, active, hashing, message, size, done, ratio, down, up in call("d.multicall2", "", "default", *fields):
    if hashing:
        status = "checking"
    elif not state:
        status = "error" if message else "stopped"
    elif not active:
        # started but inactive: paused from ruTorrent
        status = "stopped"
    else:
        status = "seeding" if complete else "downloading"
    items.append({"name": name, "status": status, "progress": done / size if size else 0, "size": size, "ratio": ratio / 1000, "down": down, "up": up})
print(json.dumps({"folder": call("directory.default"), "items": items}))
PY
            jq -c --arg u "$u" "$(summarize) .folder as \$f | .items | summarize(\"rtorrent\"; \$u; \$f)"
    fi
    [[ -n $pass ]] || return 0
    if systemctl is-active -q "qbittorrent@${u}" && [[ -z $(find "${qbt_mark}-${u}" -mmin -60 2> /dev/null) ]]; then
        # WebUI\Port= in [Preferences] up to 5.2, Port= in [WebUI] since 5.3
        port=$(read_file "$u" "/home/${u}/.config/qBittorrent/qBittorrent.conf" |
            awk -F= '/^\[/ {s = $0} (s == "[Preferences]" && $1 ~ /^WebUI.Port$/) || (s == "[WebUI]" && $1 == "Port") {print $2; exit}')
        if [[ $port =~ ^[0-9]+$ ]]; then
            reply=$(printf '%s' "$pass" | curl -sS -m 3 -i -H "Referer: http://127.0.0.1:${port}" --data-urlencode "username=${u}" --data-urlencode "password@-" \
                "http://127.0.0.1:${port}/api/v2/auth/login" 2> /dev/null)
            # the cookie is SID up to 5.2, QBT_SID_<port> since 5.3
            sid=$(grep -m1 -oiP 'set-cookie:\s*\K(QBT_)?SID(_[0-9]+)?=[^;\s]+' <<< "$reply")
            if [[ -n $sid ]]; then
                rm -f "${qbt_mark}-${u}"
                folder=$(printf 'cookie = "%s"\n' "$sid" | curl -fsS -m 3 -K - "http://127.0.0.1:${port}/api/v2/app/defaultSavePath" 2> /dev/null)
                printf 'cookie = "%s"\n' "$sid" | curl -fsS -m 4 -K - "http://127.0.0.1:${port}/api/v2/torrents/info" 2> /dev/null |
                    jq -c --arg u "$u" --arg f "$folder" "$(summarize)"'
                        map({name, size, progress, ratio, down: .dlspeed, up: .upspeed, status: (.state as $s |
                            if ($s | test("^(error|missingFiles)$")) then "error"
                            elif ($s | test("^(checking|moving)")) then "checking"
                            elif ($s | test("^(paused|stopped)")) then "stopped"
                            elif ($s | test("^queued")) then "queued"
                            elif ($s | test("(UP|uploading)$")) then "seeding"
                            else "downloading" end)})
                        | summarize("qbittorrent"; $u; $f)'
                printf 'cookie = "%s"\n' "$sid" | curl -fsS -m 3 -K - -X POST "http://127.0.0.1:${port}/api/v2/auth/logout" > /dev/null 2>&1
            elif [[ $reply == HTTP* ]]; then
                # qBittorrent answered but refused the password
                touch "${qbt_mark}-${u}"
            fi
        fi
    fi
    if systemctl is-active -q "transmission@${u}"; then
        port=$(read_file "$u" "/home/${u}/.config/transmission-daemon/settings.json" | jq -r '.["rpc-port"] // .rpc_port // empty' 2> /dev/null)
        if [[ $port =~ ^[0-9]+$ ]]; then
            # the first call answers 409 with the session id to send back
            sid=$(curl_auth "$u" "$pass" | curl -sS -m 3 -K - -i "http://127.0.0.1:${port}/transmission/rpc" 2> /dev/null | grep -m1 -oiP 'X-Transmission-Session-Id:\s*\K[A-Za-z0-9]+')
            if [[ -n $sid ]]; then
                folder=$(curl_auth "$u" "$pass" | curl -fsS -m 3 -K - -H "X-Transmission-Session-Id: ${sid}" -d '{"method":"session-get","arguments":{"fields":["download-dir"]}}' \
                    "http://127.0.0.1:${port}/transmission/rpc" 2> /dev/null | jq -r '.arguments["download-dir"] // empty' 2> /dev/null)
                curl_auth "$u" "$pass" | curl -fsS -m 4 -K - -H "X-Transmission-Session-Id: ${sid}" \
                    -d '{"method":"torrent-get","arguments":{"fields":["name","status","percentDone","sizeWhenDone","uploadRatio","rateDownload","rateUpload","error"]}}' \
                    "http://127.0.0.1:${port}/transmission/rpc" 2> /dev/null |
                    jq -c --arg u "$u" --arg f "$folder" "$(summarize)"'
                        .arguments.torrents
                        | map({name, size: .sizeWhenDone, progress: .percentDone, ratio: ([.uploadRatio, 0] | max), down: .rateDownload, up: .rateUpload, status: (
                            if .error != 0 then "error"
                            elif .status == 0 then "stopped"
                            elif .status == 1 or .status == 2 then "checking"
                            elif .status == 3 or .status == 5 then "queued"
                            elif .status == 6 then "seeding"
                            else "downloading" end)})
                        | summarize("transmission"; $u; $f)'
            fi
        fi
    fi
    if systemctl is-active -q "deluge-web@${u}"; then
        # web.conf holds two JSON objects, the port is in the second
        port=$(read_file "$u" "/home/${u}/.config/deluge/web.conf" | jq -r '.port // empty' 2> /dev/null | tail -1)
        if [[ $port =~ ^[0-9]+$ ]]; then
            jar=$(mktemp)
            # the password reaches jq through the environment and curl through stdin
            if PASS=$pass jq -nc '{method: "auth.login", params: [env.PASS], id: 1}' |
                curl -fsS -m 3 -c "$jar" -H 'Content-Type: application/json' -d @- "http://127.0.0.1:${port}/json" 2> /dev/null | jq -e '.result == true' > /dev/null 2>&1; then
                folder=$(curl -fsS -m 3 -b "$jar" -H 'Content-Type: application/json' -d '{"method":"core.get_config_value","params":["download_location"],"id":2}' \
                    "http://127.0.0.1:${port}/json" 2> /dev/null | jq -r '.result // empty' 2> /dev/null)
                curl -fsS -m 4 -b "$jar" -H 'Content-Type: application/json' \
                    -d '{"method":"web.update_ui","params":[["name","state","progress","total_wanted","ratio","download_payload_rate","upload_payload_rate"],{}],"id":3}' \
                    "http://127.0.0.1:${port}/json" 2> /dev/null |
                    jq -c --arg u "$u" --arg f "$folder" "$(summarize)"'
                        (.result.torrents // {}) | [.[]]
                        | map({name, size: .total_wanted, progress: (.progress / 100), ratio: ([.ratio, 0] | max), down: .download_payload_rate, up: .upload_payload_rate, status: (.state |
                            if . == "Error" then "error"
                            elif . == "Checking" or . == "Moving" then "checking"
                            elif . == "Paused" then "stopped"
                            elif . == "Queued" then "queued"
                            elif . == "Seeding" then "seeding"
                            else "downloading" end)})
                        | summarize("deluge"; $u; $f)'
                # deluge-web keeps every session in web.conf: end this one
                curl -fsS -m 3 -b "$jar" -H 'Content-Type: application/json' -d '{"method":"auth.delete_session","params":[],"id":4}' \
                    "http://127.0.0.1:${port}/json" > /dev/null 2>&1
            fi
            rm -f "$jar"
        fi
    fi
}

# torrents per client, every swizzin user at once. Each user gets 20 seconds at most,
# below the dashboard's 30: nothing outlives the request.
cmd_downloads() {
    local u tmp
    tmp=$(mktemp -d)
    # shellcheck source=/dev/null
    . /etc/swizzin/sources/functions/users
    export -f user_downloads read_file curl_auth summarize _get_user_password
    export qbt_mark
    while read -r u; do
        [[ $u =~ ^[a-z_][a-z0-9_.-]*$ ]] || continue
        # shellcheck disable=SC2016
        timeout -k 2 20 bash -c 'user_downloads "$1"' _ "$u" > "${tmp}/${u}" &
    done < <(_get_user_list)
    wait
    cat "$tmp"/* 2> /dev/null | jq -sc '.'
    rm -rf "$tmp"
}

cmd_power() {
    case ${1:-} in
        reboot | poweroff) ;;
        *) die "invalid power action" ;;
    esac
    # a few seconds so the dashboard can answer first
    systemd-run --quiet --collect --on-active=5 /bin/systemctl "$1"
    echo "scheduled"
}

cmd=${1:-}
shift || true
case $cmd in
    service) cmd_service "$@" ;;
    appinfo) cmd_appinfo "$@" ;;
    scripts) cmd_scripts ;;
    job) cmd_job "$@" ;;
    smart) cmd_smart ;;
    fail2ban) cmd_fail2ban ;;
    quota) cmd_quota ;;
    downloads) cmd_downloads ;;
    power) cmd_power "$@" ;;
